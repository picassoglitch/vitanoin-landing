# Public — safe to expose in the browser. Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server only, never prefix with NEXT_PUBLIC_.
# Bypasses Row Level Security, so anyone holding it can read and modify every
# application. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — password for /admin. Use a long random value.
ADMIN_PASSWORD=choose-a-long-random-password

# SECRET — "próximamente" wall. Comma-separated access codes, one per person
# or team. Removing a code signs out everyone who entered with it.
PREVIEW_CODES=code-for-panalab,code-for-agency

# Set to true at launch to take the wall down. Anything else keeps it up.
SITE_PUBLIC=false
